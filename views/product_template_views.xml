<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_equivalent" model="ir.ui.view">
        <field name="name">product.template.form.equivalent</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Equivalent Products" colspan="2">
                    <field name="direct_equivalent_product_tmpl_ids"
                           nolabel="1"
                           colspan="2"
                           domain="['&amp;', ('id', '!=', id), '|', ('company_id', '=', False), ('company_id', '=?', company_id)]"
                           options="{'no_create': True, 'no_create_edit': True}">
                        <tree width="100%">
                            <field name="default_code" width="25%"/>
                            <field name="name" width="50%"/>
                            <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                            <field name="sale_ok" optional="hide"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
