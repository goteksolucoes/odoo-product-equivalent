<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_equivalent_group_view_tree" model="ir.ui.view">
        <field name="name">product.equivalent.group.tree</field>
        <field name="model">product.equivalent.group</field>
        <field name="arch" type="xml">
            <tree string="Equivalent Product Groups" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="product_tmpl_ids"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="product_equivalent_group_view_form" model="ir.ui.view">
        <field name="name">product.equivalent.group.form</field>
        <field name="model">product.equivalent.group</field>
        <field name="arch" type="xml">
            <form string="Equivalent Product Group" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_tmpl_ids" readonly="1">
                                <tree>
                                    <field name="default_code"/>
                                    <field name="name"/>
                                    <field name="categ_id" optional="show"/>
                                    <field name="sale_ok" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Commercial notes about this equivalence group..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_equivalent_group_action" model="ir.actions.act_window">
        <field name="name">Equivalent Product Groups</field>
        <field name="res_model">product.equivalent.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="product_equivalent_group_menu"
              name="Equivalent Product Groups"
              parent="sale.prod_config_main"
              action="product_equivalent_group_action"
              sequence="90"
              groups="sales_team.group_sale_manager"
              active="False"/>
</odoo>
